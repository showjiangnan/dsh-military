{
  "name": "@dsh-military/contracts",
  "version": "0.9.0-alpha.28",
  "description": "Canonical contracts, schemas and generated event/error types.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./role-prompts": {
      "types": "./lib/role-prompts.d.ts",
      "default": "./lib/role-prompts.js"
    },
    "./control-plane": {
      "types": "./lib/control-plane.d.ts",
      "default": "./lib/control-plane.js"
    },
    "./operations-control": {
      "types": "./lib/operations-control.d.ts",
      "default": "./lib/operations-control.js"
    },
    "./workspace-control": {
      "types": "./lib/workspace-control.d.ts",
      "default": "./lib/workspace-control.js"
    },
    "./benchmark-control": {
      "types": "./lib/benchmark-control.d.ts",
      "default": "./lib/benchmark-control.js"
    },
    "./knowledge-control": {
      "types": "./lib/knowledge-control.d.ts",
      "default": "./lib/knowledge-control.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./schemas/*": "./schemas/*",
    "./catalogs/*": "./catalogs/*",
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "schemas/*.json",
    "catalogs/*.json",
    "migrations/*.sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2"
  }
}
