{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effectiveness-assessment.schema.json",
  "title": "Tactical Effectiveness Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assessmentId",
    "missionId",
    "triggerRef",
    "window",
    "skillAssessments",
    "systemMetrics",
    "limitations",
    "sourceEventIds",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "assessmentId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "missionId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "triggerRef": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromEventId",
        "toEventId"
      ],
      "properties": {
        "fromEventId": {
          "$ref": "common-defs.schema.json#/$defs/id"
        },
        "toEventId": {
          "$ref": "common-defs.schema.json#/$defs/id"
        }
      }
    },
    "skillAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "assigned",
          "attempted",
          "accepted",
          "contributionLevel",
          "description"
        ],
        "properties": {
          "skill": {
            "$ref": "common-defs.schema.json#/$defs/skillRef"
          },
          "assigned": {
            "type": "integer",
            "minimum": 0
          },
          "attempted": {
            "type": "integer",
            "minimum": 0
          },
          "accepted": {
            "type": "integer",
            "minimum": 0
          },
          "firstPassAccepted": {
            "type": "integer",
            "minimum": 0
          },
          "contributionLevel": {
            "enum": [
              "none",
              "correlated",
              "incremental",
              "causal-supported"
            ]
          },
          "description": {
            "type": "string"
          },
          "negativeEffects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "systemMetrics": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceEventIds": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/id"
      },
      "minItems": 1
    },
    "createdAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    }
  }
}
