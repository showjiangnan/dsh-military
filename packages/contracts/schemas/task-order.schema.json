{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-order.schema.json",
  "title": "Task Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "missionId",
    "directionId",
    "waveId",
    "taskId",
    "taskVersion",
    "objective",
    "whyItMatters",
    "taskType",
    "assignedRole",
    "complexity",
    "scope",
    "allowedTools",
    "requiredEvidence",
    "acceptance",
    "dependencies",
    "tactics",
    "environmentSnapshotRef",
    "stopConditions",
    "escalationConditions",
    "budget"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "missionId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "directionId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "waveId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "taskId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "taskVersion": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "whyItMatters": {
      "type": "string",
      "minLength": 1
    },
    "taskType": {
      "type": "string",
      "minLength": 1
    },
    "assignedRole": {
      "enum": [
        "worker",
        "engineer"
      ]
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticDecisions",
        "unknownDependencies",
        "writeDomains",
        "toolFamilies",
        "acceptanceAmbiguity",
        "integrationFanOut",
        "contextFootprint"
      ],
      "properties": {
        "semanticDecisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "unknownDependencies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "writeDomains": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "toolFamilies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "acceptanceAmbiguity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "integrationFanOut": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "contextFootprint": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        }
      }
    },
    "scope": {
      "$ref": "common-defs.schema.json#/$defs/pathScope"
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requiredEvidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "version"
      ],
      "properties": {
        "contractId": {
          "$ref": "common-defs.schema.json#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/dependencyEdge"
      }
    },
    "tactics": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/skillRef"
      }
    },
    "environmentSnapshotRef": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "stopConditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalationConditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "$ref": "common-defs.schema.json#/$defs/budget"
    }
  }
}
