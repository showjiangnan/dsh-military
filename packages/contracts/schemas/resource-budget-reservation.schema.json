{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-budget-reservation.schema.json",
  "title": "Resource Budget Reservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reservationId",
    "tenantId",
    "scopeType",
    "scopeId",
    "policyId",
    "policyRevision",
    "ownerAgent",
    "requested",
    "granted",
    "state",
    "idempotencyKey",
    "reservedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "reservationId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "tenantId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "scopeType": {
      "enum": [
        "DEPLOYMENT",
        "TENANT",
        "MISSION",
        "WAVE",
        "TASK"
      ]
    },
    "scopeId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "policyId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "policyRevision": {
      "$ref": "common-defs.schema.json#/$defs/revision"
    },
    "ownerAgent": {
      "$ref": "common-defs.schema.json#/$defs/agentIdentity"
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRequests",
        "reasoningTokens",
        "wallClockSeconds",
        "toolCalls",
        "apiCalls",
        "concurrentAgents",
        "radioRounds",
        "reworkAttempts",
        "storageBytes"
      ],
      "properties": {
        "modelRequests": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningTokens": {
          "type": "integer",
          "minimum": 0
        },
        "wallClockSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "apiCalls": {
          "type": "integer",
          "minimum": 0
        },
        "concurrentAgents": {
          "type": "integer",
          "minimum": 0
        },
        "radioRounds": {
          "type": "integer",
          "minimum": 0
        },
        "reworkAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "storageBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "granted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRequests",
        "reasoningTokens",
        "wallClockSeconds",
        "toolCalls",
        "apiCalls",
        "concurrentAgents",
        "radioRounds",
        "reworkAttempts",
        "storageBytes"
      ],
      "properties": {
        "modelRequests": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningTokens": {
          "type": "integer",
          "minimum": 0
        },
        "wallClockSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "apiCalls": {
          "type": "integer",
          "minimum": 0
        },
        "concurrentAgents": {
          "type": "integer",
          "minimum": 0
        },
        "radioRounds": {
          "type": "integer",
          "minimum": 0
        },
        "reworkAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "storageBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "state": {
      "enum": [
        "RESERVED",
        "SETTLED",
        "EXPIRED",
        "REVOKED",
        "REJECTED"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "reservedAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    }
  }
}
