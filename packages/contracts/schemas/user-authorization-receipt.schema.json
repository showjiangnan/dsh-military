{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user-authorization-receipt.schema.json",
  "title": "User Authorization Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorizationId",
    "principalId",
    "tenantId",
    "action",
    "resource",
    "constraints",
    "issuedAt",
    "expiresAt",
    "revocable",
    "sourceSessionId",
    "sourceMessageId",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "authorizationId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "principalId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "tenantId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "issuedAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "revocable": {
      "type": "boolean"
    },
    "sourceSessionId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "sourceMessageId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
