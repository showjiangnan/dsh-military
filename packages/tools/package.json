{
  "name": "@dsh-military/tools",
  "version": "0.9.0-alpha.25",
  "description": "Military model-facing tools for General and child agents.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./general": {
      "types": "./lib/general.d.ts",
      "default": "./lib/general.js"
    },
    "./worker": {
      "types": "./lib/worker.d.ts",
      "default": "./lib/worker.js"
    },
    "./staff": {
      "types": "./lib/staff.d.ts",
      "default": "./lib/staff.js"
    },
    "./engineer": {
      "types": "./lib/engineer.d.ts",
      "default": "./lib/engineer.js"
    },
    "./inspector": {
      "types": "./lib/inspector.d.ts",
      "default": "./lib/inspector.js"
    },
    "./research": {
      "types": "./lib/research.d.ts",
      "default": "./lib/research.js"
    },
    "./runtime-validation": {
      "types": "./lib/runtime-validation.d.ts",
      "default": "./lib/runtime-validation.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dsh-military/contracts": "0.9.0-alpha.25",
    "@dsh-military/infrastructure": "0.9.0-alpha.25",
    "@dsh-military/runtime": "0.9.0-alpha.25",
    "@dsh-military/core": "0.9.0-alpha.25"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2"
  }
}
