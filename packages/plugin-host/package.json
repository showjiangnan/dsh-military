{
  "name": "@dsh-military/plugin-host",
  "version": "0.9.0-alpha.25",
  "description": "Host-plane services and RC.2 agent/session adapters for dsh-military.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./agent-plane": {
      "types": "./lib/agent-plane.d.ts",
      "default": "./lib/agent-plane.js"
    },
    "./session-events": {
      "types": "./lib/session-events.d.ts",
      "default": "./lib/session-events.js"
    },
    "./general-model-default": {
      "types": "./lib/general-model-default.d.ts",
      "default": "./lib/general-model-default.js"
    },
    "./defaults": {
      "types": "./lib/defaults.d.ts",
      "default": "./lib/defaults.js"
    },
    "./tool-authorization": {
      "types": "./lib/tool-authorization.d.ts",
      "default": "./lib/tool-authorization.js"
    },
    "./model-budget": {
      "types": "./lib/model-budget.d.ts",
      "default": "./lib/model-budget.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dsh-military/contracts": "0.9.0-alpha.25",
    "@dsh-military/core": "0.9.0-alpha.25",
    "@dsh-military/runtime": "0.9.0-alpha.25",
    "@dsh-military/infrastructure": "0.9.0-alpha.25",
    "@dsh-military/storage-sqlite": "0.9.0-alpha.25",
    "@dsh-military/preset": "0.9.0-alpha.25"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2"
  }
}
