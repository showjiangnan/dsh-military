{
  "name": "@dsh-military/storage-sqlite",
  "version": "0.9.0-alpha.27",
  "description": "SQLite event, governance and binding providers for dsh-military.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/migrations/*.sql",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dsh-military/contracts": "0.9.0-alpha.27",
    "@dsh-military/core": "0.9.0-alpha.27",
    "@dsh-military/runtime": "0.9.0-alpha.27"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2"
  }
}
