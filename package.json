{
  "name": "dsh-military-source",
  "version": "0.9.0-alpha.24",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Complete source workspace for dsh-military, aligned to DeepSeek Harness 0.1.1-rc.2.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate": "node scripts/generate-contracts.mjs && node scripts/generate-preset-generation.mjs",
    "typecheck": "tsc -p tsconfig.validation.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/run-tests.mjs",
    "review": "node scripts/review.mjs",
    "docs:validate": "node scripts/run-docs-validator.mjs",
    "validate": "node scripts/validate.mjs",
    "pack:source": "node scripts/pack-source.mjs",
    "all": "npm run all:local",
    "typecheck:rc2": "node scripts/typecheck-rc2.mjs",
    "verify:rc2": "node scripts/check-rc2-contract.mjs",
    "verify:rc2-profile": "node scripts/verify-rc2-profile.mjs",
    "all:rc2": "npm run all:local && npm run typecheck:rc2",
    "e2e:rc2": "node scripts/run-rc2-e2e.mjs",
    "repair:regressions": "node scripts/run-repair-regressions.mjs",
    "semantic:audit": "node scripts/semantic-release-audit.mjs",
    "all:local": "npm run generate && npm run typecheck && npm run verify:rc2 && npm run build && npm test && npm run repair:regressions && npm run semantic:audit && npm run review && npm run validate",
    "release:build": "node scripts/build-release.mjs",
    "release:verify": "npm run all:rc2 && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "22.15.0",
    "@types/react": "~18.3.1",
    "@types/react-test-renderer": "18.0.7",
    "esbuild": "0.25.12",
    "react": "18.2.0",
    "react-test-renderer": "18.2.0",
    "publint": "0.3.24",
    "typescript": "6.0.3"
  }
}
