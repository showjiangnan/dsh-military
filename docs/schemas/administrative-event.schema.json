              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "principalId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      }
    },
    {
      "title": "Tactical ingestion requested",
      "properties": {
        "type": {
          "const": "tactical-ingestion/requested"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "sourceKind",
            "requestedTagIds"
          ],
          "properties": {
            "requestId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "sourceKind": {
              "enum": [
                "SESSION_RANGE",
                "DIRECT_TEXT",
                "ARTIFACT"
              ]
            },
            "requestedTagIds": {
              "type": "array",
              "items": {
                "$ref": "common-defs.schema.json#/$defs/id"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    {
      "title": "Tactical source snapshotted",
      "properties": {
        "type": {
          "const": "tactical-ingestion/source-snapshotted"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "snapshotId",
            "sourceHash",
            "classification"
          ],
          "properties": {
            "requestId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "snapshotId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "sourceHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "classification": {
              "$ref": "common-defs.schema.json#/$defs/classification"
            }
          }
        }
      }
    },
    {
      "title": "Tactical extraction candidate created",
      "properties": {
        "type": {
          "const": "tactical-ingestion/candidate-created"
