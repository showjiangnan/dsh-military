            "status"
          ],
          "properties": {
            "policyId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "DRAFT",
                "ACTIVE",
                "PAUSED",
                "REVOKED",
                "RETIRED"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Verifier profile changed",
