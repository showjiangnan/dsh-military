{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "administrative-event.schema.json",
  "title": "Military Cross-session Administrative Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "seq",
    "aggregateRevision",
    "type",
    "timestamp",
    "payload",
    "actorId",
    "tenantId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "eventId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "aggregateRevision": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string"
    },
    "timestamp": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "causationId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "correlationId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "idempotencyKey": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "payload": {
      "type": "object"
    },
    "actorId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "tenantId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    }
  },
  "oneOf": [
    {
      "title": "Tactical tag changed",
      "properties": {
        "type": {
          "const": "tag/changed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tagId",
            "revision",
            "operation"
          ],
          "properties": {
            "tagId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "operation": {
              "enum": [
                "created",
                "renamed",
                "paused",
                "resumed",
                "deleted"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Agent template changed",
      "properties": {
        "type": {
          "const": "agent-template/changed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "templateId",
            "revision",
            "operation"
          ],
          "properties": {
            "templateId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "operation": {
              "enum": [
                "created",
                "activated",
                "paused",
                "retired"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Tool profile changed",
      "properties": {
        "type": {
          "const": "tool-profile/changed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolProfileId",
            "revision",
            "operation"
          ],
          "properties": {
            "toolProfileId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "operation": {
              "enum": [
                "created",
                "activated",
                "paused",
                "retired"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Permission profile changed",
      "properties": {
        "type": {
          "const": "permission-profile/changed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permissionProfileId",
            "revision",
            "operation"
          ],
          "properties": {
            "permissionProfileId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "operation": {
              "enum": [
                "created",
                "activated",
                "revoked",
                "retired"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Enterprise API grant changed",
      "properties": {
        "type": {
          "const": "api-grant/changed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grantId",
            "revision",
            "operation"
          ],
          "properties": {
            "grantId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "operation": {
              "enum": [
                "created",
                "activated",
                "revoked",
                "expired"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Model capability profile changed",
      "properties": {
        "type": {
          "const": "model-capability/changed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profileId",
            "revision",
            "provider",
            "model",
            "operation"
          ],
          "properties": {
            "profileId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "operation": {
              "enum": [
                "created",
                "validated",
                "deprecated"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Context manifest created",
      "properties": {
        "type": {
          "const": "context/manifest-created"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifestId",
            "missionId",
            "taskId",
            "taskVersion",
            "missionRevision",
            "agentId",
            "agentGeneration",
            "sessionId",
            "turn",
            "step",
            "artifactRef",
            "manifestSha256",
            "sectionKinds",
            "omittedEvidenceCount",
            "tokenBudget"
          ],
          "properties": {
            "manifestId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "missionId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "taskId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "taskVersion": {
              "type": "integer",
              "minimum": 1
            },
            "missionRevision": {
              "type": "integer",
              "minimum": 0
            },
            "agentId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "agentGeneration": {
              "type": "integer",
              "minimum": 1
            },
            "sessionId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "turn": {
              "type": "integer",
              "minimum": 0
            },
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "artifactRef": {
              "$ref": "common-defs.schema.json#/$defs/artifactRef"
            },
            "manifestSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sectionKinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "CONSTITUTION",
                  "STATE",
                  "EVIDENCE",
                  "WORKING"
                ]
              }
            },
            "omittedEvidenceCount": {
              "type": "integer",
              "minimum": 0
            },
            "tokenBudget": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "title": "Data residency policy changed",
      "properties": {
        "type": {
          "const": "data-residency-policy/changed"
