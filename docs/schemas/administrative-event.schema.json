            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "DRAFT",
                "ACTIVE",
                "PAUSED",
                "REVOKED",
                "RETIRED"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Redaction policy changed",
      "properties": {
        "type": {
          "const": "redaction-policy/changed"
        },
        "payload": {
          "type": "object",
