          ],
          "properties": {
            "policyId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "DRAFT",
                "ACTIVE",
                "PAUSED",
                "REVOKED",
                "RETIRED"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Authorization granted",
      "properties": {
        "type": {
          "const": "authorization/granted"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorizationId",
            "principalId",
            "scope",
            "expiresAt"
          ],
          "properties": {
            "authorizationId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "principalId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "expiresAt": {
              "$ref": "common-defs.schema.json#/$defs/timestamp"
            }
          }
        }
      }
    },
    {
      "title": "Authorization revoked",
      "properties": {
        "type": {
          "const": "authorization/revoked"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
