            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "DRAFT",
                "ACTIVE",
                "PAUSED",
                "REVOKED",
                "RETIRED"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Resource budget policy changed",
      "properties": {
        "type": {
          "const": "resource-budget-policy/changed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policyId",
