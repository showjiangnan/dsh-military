          ],
          "properties": {
            "requestId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "candidateId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "candidateHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "operation": {
              "enum": [
                "NEW_TACTIC",
                "SUPPLEMENT"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Tactical ingestion reviewed",
