          ],
          "properties": {
            "revocationOrderId": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "disposition": {
              "enum": [
                "CLEARED",
                "PARTIALLY_CLEARED",
                "REMAINS_QUARANTINED"
              ]
            },
            "reverifiedTaskIds": {
              "type": "array",
              "items": {
                "$ref": "common-defs.schema.json#/$defs/id"
              },
              "uniqueItems": true
            },
            "reportRef": {
              "$ref": "common-defs.schema.json#/$defs/id"
            }
          }
        }
