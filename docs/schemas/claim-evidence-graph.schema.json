{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-evidence-graph.schema.json",
  "title": "Claim Evidence Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "graphId", "candidateId", "claims", "links", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "graphId": { "$ref": "common-defs.schema.json#/$defs/id" },
    "candidateId": { "$ref": "common-defs.schema.json#/$defs/id" },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claimId", "statement", "type", "required", "minimumTier"],
        "properties": {
          "claimId": { "$ref": "common-defs.schema.json#/$defs/id" },
          "statement": { "type": "string", "minLength": 1 },
          "type": { "enum": ["implementation", "behavior", "security", "compatibility", "performance", "documentation"] },
          "required": { "type": "boolean" },
          "minimumTier": { "enum": ["V0", "V1", "V2", "V3", "V4"] }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claimId", "evidenceRef", "supports", "tier", "producedAtRevision"],
        "properties": {
          "claimId": { "$ref": "common-defs.schema.json#/$defs/id" },
          "evidenceRef": { "type": "string", "minLength": 1 },
          "supports": { "type": "boolean" },
          "tier": { "enum": ["V0", "V1", "V2", "V3", "V4"] },
          "validityScope": { "type": "string" },
          "producedAtRevision": { "type": "integer", "minimum": 0 },
          "expiresAt": { "$ref": "common-defs.schema.json#/$defs/timestamp" }
        }
      }
    },
    "createdAt": { "$ref": "common-defs.schema.json#/$defs/timestamp" }
  }
}
