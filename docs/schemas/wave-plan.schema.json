{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wave-plan.schema.json",
  "title": "Wave Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "missionId",
    "directionId",
    "waveId",
    "version",
    "objective",
    "environmentSnapshotRef",
    "entranceCriteria",
    "taskIds",
    "barrier",
    "capacity",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "missionId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "directionId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "waveId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "environmentSnapshotRef": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "entranceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "taskIds": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxWorkers",
        "reservedForRework",
        "maxVerifierConcurrency"
      ],
      "properties": {
        "maxWorkers": {
          "type": "integer",
          "minimum": 1
        },
        "reservedForRework": {
          "type": "integer",
          "minimum": 0
        },
        "maxVerifierConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "maxAdvisorConcurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budget": {
      "$ref": "common-defs.schema.json#/$defs/budget"
    },
    "barrier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allRequiredTasksAccepted",
        "integrationVerifierIds",
        "specsCommitRequired",
        "noCriticalOversightFindings"
      ],
      "properties": {
        "allRequiredTasksAccepted": {
          "const": true
        },
        "integrationVerifierIds": {
          "type": "array",
          "items": {
            "$ref": "common-defs.schema.json#/$defs/id"
          }
        },
        "specsCommitRequired": {
          "type": "boolean"
        },
        "noCriticalOversightFindings": {
          "type": "boolean"
        },
        "additionalCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "ACTIVE",
        "BARRIER_PENDING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    }
  }
}
