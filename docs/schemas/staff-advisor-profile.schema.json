{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "staff-advisor-profile.schema.json",
  "title": "Staff Advisor Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "advisorId",
    "revision",
    "displayName",
    "status",
    "responsibilities",
    "nonResponsibilities",
    "domains",
    "modelPolicy",
    "permissions",
    "budgets",
    "lifecycle"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "advisorId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "CANARY",
        "ACTIVE",
        "SUSPENDED",
        "RETIRED"
      ]
    },
    "description": {
      "type": "string"
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "nonResponsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scenarioTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoningEffort",
        "maxTokens"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasoningEffort": {
          "$ref": "common-defs.schema.json#/$defs/reasoningEffort"
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "fallbackProfiles": {
          "type": "array",
          "items": {
            "$ref": "common-defs.schema.json#/$defs/id"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "tacticalSkillPatterns",
        "apiGrants",
        "dataClassificationCeiling"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tacticalSkillPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "apiGrants": {
          "type": "array",
          "items": {
            "$ref": "common-defs.schema.json#/$defs/apiGrant"
          }
        },
        "dataClassificationCeiling": {
          "$ref": "common-defs.schema.json#/$defs/classification"
        },
        "secretCredentialRefs": {
          "type": "array",
          "items": {
            "$ref": "common-defs.schema.json#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxConcurrentConsultations",
        "maxRequestsPerMission"
      ],
      "properties": {
        "maxConcurrentConsultations": {
          "type": "integer",
          "minimum": 1
        },
        "maxRequestsPerMission": {
          "type": "integer",
          "minimum": 1
        },
        "maxGuidancePerTask": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "costWeight": {
          "type": "number",
          "minimum": 0
        },
        "latencyWeight": {
          "type": "number",
          "minimum": 0
        },
        "qualityWeight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt",
        "createdBy"
      ],
      "properties": {
        "createdAt": {
          "$ref": "common-defs.schema.json#/$defs/timestamp"
        },
        "createdBy": {
          "type": "string"
        },
        "lastReviewedAt": {
          "$ref": "common-defs.schema.json#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "common-defs.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
