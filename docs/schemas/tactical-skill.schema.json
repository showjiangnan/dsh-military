{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tactical-skill.schema.json",
  "title": "Versioned Tactical Procedure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "version",
    "title",
    "lifecycle",
    "scenarios",
    "preconditions",
    "exclusions",
    "compatibility",
    "stateMachine",
    "playbook",
    "expectedObservations",
    "verifierContract",
    "stopConditions",
    "rollback",
    "knownFailureModes",
    "provenance",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "skillId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common-defs.schema.json#/$defs/semver"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "DRAFT",
        "SIMULATION",
        "CANARY",
        "TESTING",
        "STABLE",
        "QUARANTINED",
        "DEPRECATED"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskTypes"
      ],
      "properties": {
        "taskTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataClassificationCeiling": {
          "$ref": "common-defs.schema.json#/$defs/classification"
        }
      }
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial",
        "states",
        "transitions"
      ],
      "properties": {
        "initial": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "condition"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "actionStepIds": {
                "type": "array",
                "items": {
                  "$ref": "common-defs.schema.json#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    "playbook": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "action"
        ],
        "properties": {
          "stepId": {
            "$ref": "common-defs.schema.json#/$defs/id"
          },
          "action": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "evidenceRequired": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retryLimit": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "expectedObservations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifierContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifierIds",
        "successConditions"
      ],
      "properties": {
        "verifierIds": {
          "type": "array",
          "items": {
            "$ref": "common-defs.schema.json#/$defs/id"
          },
          "minItems": 1
        },
        "successConditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "negativeChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stopConditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "knownFailureModes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "symptom",
          "response"
        ],
        "properties": {
          "code": {
            "$ref": "common-defs.schema.json#/$defs/id"
          },
          "symptom": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        }
      }
    },
    "conflictsWith": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/skillRef"
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/skillRef"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/evidenceRef"
      },
      "minItems": 1
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trials",
        "acceptedResults"
      ],
      "properties": {
        "trials": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedResults": {
          "type": "integer",
          "minimum": 0
        },
        "firstPassAccepted": {
          "type": "integer",
          "minimum": 0
        },
        "meanRetries": {
          "type": "number",
          "minimum": 0
        },
        "lastEvaluatedAt": {
          "$ref": "common-defs.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
