{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tactical-guidance.schema.json",
  "title": "Tactical Guidance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "guidanceId",
    "requestId",
    "expectedTaskVersion",
    "advisorIdentity",
    "candidateSkills",
    "selectedSkills",
    "diagnosis",
    "directive",
    "expectedObservations",
    "requiredEvidence",
    "stopConditions",
    "fallback",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "guidanceId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "requestId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "expectedTaskVersion": {
      "type": "integer",
      "minimum": 1
    },
    "advisorIdentity": {
      "$ref": "common-defs.schema.json#/$defs/agentIdentity"
    },
    "candidateSkills": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/skillRef"
      },
      "maxItems": 5
    },
    "selectedSkills": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/skillRef"
      },
      "maxItems": 3
    },
    "diagnosis": {
      "type": "string",
      "minLength": 1
    },
    "directive": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "action"
        ],
        "properties": {
          "stepId": {
            "$ref": "common-defs.schema.json#/$defs/id"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "expectedOutput": {
            "type": "string"
          }
        }
      }
    },
    "expectedObservations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requiredEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "stopConditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    }
  }
}
