{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-capability-profile.schema.json",
  "title": "Model Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "revision",
    "status",
    "provider",
    "model",
    "supportedReasoning",
    "contextWindowTokens",
    "maxOutputTokens",
    "toolCalling",
    "inputModalities",
    "reasoningPassback",
    "dataResidencyPolicyRefs",
    "benchmarks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "profileId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "CANARY",
        "VALIDATED",
        "DEPRECATED"
      ]
    },
    "catalogPresence": {
      "enum": ["PRESENT", "ABSENT", "UNKNOWN"]
    },
    "protocolCompatibility": {
      "enum": [
        "DSH_TOOL_REQUEST_AVAILABLE",
        "NATIVE_TOOL_CALLING_VERIFIED",
        "BRIDGED_TOOL_CALLING_VERIFIED",
        "TEXT_ONLY",
        "UNKNOWN"
      ]
    },
    "policyEligibility": {
      "enum": [
        "ELIGIBLE",
        "ELIGIBLE_UNVERIFIED",
        "CANARY_ONLY",
        "INELIGIBLE"
      ]
    },
    "performanceEvidence": {
      "enum": ["UNASSESSED", "CANARY", "VALIDATED"]
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "supportedReasoning": {
      "type": "array",
      "items": {
        "enum": [
          "off",
          "low",
          "high",
          "max"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "contextWindowTokens": {
      "type": "integer",
      "minimum": 1
    },
    "maxOutputTokens": {
      "type": "integer",
      "minimum": 1
    },
    "toolCalling": {
      "type": "boolean"
    },
    "vision": {
      "type": "boolean"
    },
    "dataResidencyPolicyRefs": {
      "type": "array",
      "items": {
        "$ref": "common-defs.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reasoning": {
            "enum": [
              "low",
              "high",
              "max"
            ]
          },
          "sampleCount": {
            "type": "integer",
            "minimum": 1
          },
          "finalAcceptanceRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "falseCompletionRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "taskType",
          "reasoning",
          "sampleCount",
          "finalAcceptanceRate",
          "falseCompletionRate"
        ]
      }
    },
    "validatedAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "observedAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "inputModalities": {
      "type": "array",
      "items": {
        "enum": [
          "text",
          "image"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "reasoningPassback": {
      "enum": [
        "all-reasoning-turns",
        "provider-defined",
        "none",
        "unknown"
      ]
    },
    "capabilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextWindow",
        "maxOutput",
        "toolCalling",
        "reasoning",
        "inputModalities",
        "residency"
      ],
      "properties": {
        "contextWindow": {
          "enum": ["ADAPTER_DECLARED", "CONSERVATIVE_FALLBACK"]
        },
        "maxOutput": {
          "enum": ["ADAPTER_DECLARED", "CONSERVATIVE_FALLBACK"]
        },
        "toolCalling": {
          "enum": ["BUILT_IN_VERIFIED", "LIVE_CANARY", "UNVERIFIED"]
        },
        "reasoning": {
          "enum": ["ADAPTER_DECLARED", "UNDECLARED"]
        },
        "inputModalities": {
          "enum": ["ADAPTER_DECLARED", "UNDECLARED"]
        },
        "residency": {
          "enum": ["POLICY_BOUND", "UNDECLARED"]
        }
      }
    },
    "maximumRequestImageBytes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "VALIDATED" } },
        "required": ["status"]
      },
      "then": { "required": ["validatedAt"] }
    }
  ]
}
