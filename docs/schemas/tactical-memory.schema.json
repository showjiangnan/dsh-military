{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tactical-memory.schema.json",
  "title": "Tactical Memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "memoryId",
    "missionId",
    "boundaryRef",
    "missionState",
    "confirmedFacts",
    "acceptedProgress",
    "openBlockers",
    "riskChanges",
    "lessons",
    "recommendedStrategicActions",
    "evidenceIndex",
    "createdBy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "memoryId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "missionId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "boundaryRef": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "missionState": {
      "type": "string"
    },
    "confirmedFacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptedProgress": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisionsAndRationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openBlockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskChanges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendedStrategicActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIndex": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "sourceEventIds",
          "confidence",
          "validityScope"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "sourceEventIds": {
            "type": "array",
            "items": {
              "$ref": "common-defs.schema.json#/$defs/id"
            },
            "minItems": 1
          },
          "artifactRefs": {
            "type": "array",
            "items": {
              "$ref": "common-defs.schema.json#/$defs/artifactRef"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "validityScope": {
            "type": "string"
          }
        }
      }
    },
    "createdBy": {
      "$ref": "common-defs.schema.json#/$defs/agentIdentity"
    },
    "createdAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    }
  }
}
