{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conformance-trace.schema.json",
  "title": "dsh-military Golden Conformance Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "traceId",
    "scenario",
    "dshBaseline",
    "initialState",
    "steps",
    "finalProjectionHash",
    "invariants"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "traceId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "dshBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "commit"
      ],
      "properties": {
        "release": {
          "const": "0.1.1-rc.2"
        },
        "commit": {
          "const": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e"
        }
      }
    },
    "initialState": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "action",
          "eventType",
          "expectedState"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "eventType": {
            "type": "string",
            "minLength": 1
          },
          "expectedState": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "finalProjectionHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
