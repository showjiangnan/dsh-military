{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compaction-attempt.schema.json",
  "title": "Military Compaction Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "agent",
    "rootSessionId",
    "pressureGeneration",
    "contextBudgetTokens",
    "thresholdTokens",
    "meterTokens",
    "trigger",
    "safeBoundary",
    "outcome",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "attemptId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "agent": {
      "$ref": "common-defs.schema.json#/$defs/agentIdentity"
    },
    "rootSessionId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "templateId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "templateRevision": {
      "type": "integer",
      "minimum": 1
    },
    "pressureGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "contextBudgetTokens": {
      "type": "integer",
      "minimum": 1
    },
    "thresholdTokens": {
      "type": "integer",
      "minimum": 1
    },
    "meterTokens": {
      "type": "integer",
      "minimum": 1
    },
    "trigger": {
      "enum": [
        "PRESSURE",
        "CONTEXT_OVERFLOW",
        "MANUAL",
        "HANDOFF"
      ]
    },
    "safeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolPairsBalanced": {
          "type": "boolean"
        },
        "candidateTransactionIdle": {
          "type": "boolean"
        },
        "gitTransactionIdle": {
          "type": "boolean"
        },
        "freezeStateStable": {
          "type": "boolean"
        }
      },
      "required": [
        "toolPairsBalanced",
        "candidateTransactionIdle",
        "gitTransactionIdle",
        "freezeStateStable"
      ]
    },
    "outcome": {
      "enum": [
        "PENDING",
        "SUCCEEDED",
        "NO_SAFE_RANGE",
        "FAILED",
        "CANCELLED"
      ]
    },
    "dshCompactionId": {
      "$ref": "common-defs.schema.json#/$defs/id"
    },
    "summaryEventSeq": {
      "type": "integer",
      "minimum": 1
    },
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "createdAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "completedAt": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    }
  }
}
